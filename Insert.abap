REPORT ZINSERT.

TYPES: BEGIN OF TY_STR,
        CUST TYPE I,
        COUNTRY TYPE STRING,
        NAME TYPE STRING,
        CITY TYPE STRING,
      END OF TY_STR.

DATA: IT TYPE TABLE OF TY_STR,
      WA TYPE TY_STR,
      NEW TYPE TABLE OF TY_STR.

APPEND VALUE #( CUST = 100 COUNTRY = 'INDIA' NAME = 'ANU' CITY = 'PUNE' ) TO IT.
APPEND VALUE #( CUST = 101 COUNTRY = 'INDIA' NAME = 'ANJU' CITY = 'MUMBAI' ) TO IT.

WA-CUST = 102.
WA-COUNTRY = 'USA'.
WA-NAME = 'ALICE'.
WA-CITY = 'LA'.
INSERT WA INTO IT INDEX 2.
INSERT VALUE #( CUST = 103 COUNTRY = 'FRANCE' NAME = 'ANN' CITY = 'PARIS' ) INTO IT INDEX 3.

APPEND VALUE #( CUST = 104 COUNTRY = 'INDIA' NAME = 'ANU' CITY = 'PUNE' ) TO NEW.
APPEND VALUE #( CUST = 105 COUNTRY = 'INDIA' NAME = 'ANJU' CITY = 'MUMBAI' ) TO NEW.

INSERT LINES OF NEW INTO IT INDEX 1.

LOOP AT IT INTO WA.
  WRITE: / WA-CUST,
           20 WA-COUNTRY,
           30 WA-NAME,
           40 WA-CITY.
ENDLOOP.

WRITE: / '***********************SORT**************************'.
SORT IT BY CUST.
LOOP AT IT INTO WA.
  WRITE: / WA-CUST,
           20 WA-COUNTRY,
           30 WA-NAME,
           40 WA-CITY.
ENDLOOP.

WRITE: / '***********************DESCRIBE**************************'.
DATA V TYPE I.
DESCRIBE TABLE IT LINES V.
WRITE: / 'TOTAL RECORDS IN TABLE IT ARE: ', V.
