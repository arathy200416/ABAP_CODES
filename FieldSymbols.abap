REPORT ZFS_SECOND.

TYPES: BEGIN OF TY_STR,
        ID TYPE C LENGTH 2,
        VAL TYPE I,
      END OF TY_STR.



DATA: IT TYPE TABLE OF TY_STR,
      WA TYPE  TY_STR.

FIELD-SYMBOLS: <FS> TYPE TY_STR.

WA-ID = 'A1'. WA-VAL = 10. APPEND WA TO IT.
WA-ID = 'B1'. WA-VAL = 20. APPEND WA TO IT.

WRITE: / 'BEFORE MODIFYINFG THE FS'.

LOOP AT IT INTO WA.
  WRITE: / WA-ID,
            20 WA-VAL.
ENDLOOP.

LOOP AT IT ASSIGNING <FS>.
  <FS>-VAL = <FS>-VAL * 2.
ENDLOOP.

WRITE: / 'AFTER MODIFYINFG THE FS - > FS'.
LOOP AT IT ASSIGNING <FS>.
  WRITE: / <FS>-ID,
            20 <FS>-VAL.
ENDLOOP.

WRITE: / 'AFTER MODIFYINFG THE FS-> WA'.
LOOP AT IT INTO WA.
  WRITE: / WA-ID,
            20 WA-VAL.
ENDLOOP.
