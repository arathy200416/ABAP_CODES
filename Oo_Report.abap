REPORT ZOOREPORT.

CLASS REPORT DEFINITION.
  PUBLIC SECTION.
  METHODS: GET, DISPLAY.
  PRIVATE SECTION.
  DATA: IT TYPE STANDARD TABLE OF SCARR.
ENDCLASS.

CLASS REPORT IMPLEMENTATION.
  METHOD GET.
    SELECT * FROM SCARR INTO TABLE IT UP TO 20 ROWS.
  ENDMETHOD.
  METHOD DISPLAY.
    DATA: LO_ALV TYPE REF TO CL_SALV_TABLE.
    CL_SALV_TABLE=>FACTORY(
      IMPORTING R_SALV_TABLE = LO_ALV
      CHANGING T_TABLE       = IT ).
    LO_ALV->DISPLAY( ).
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
DATA LO_REPORT TYPE REF TO REPORT.
CREATE OBJECT LO_REPORT.
LO_REPORT->GET( ).
LO_REPORT->DISPLAY( ).
