REPORT ZPROJECT_ALV2.

TABLES SFLIGHT.

SELECTION-SCREEN: BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-000.
  SELECT-OPTIONS: A_DATE FOR SFLIGHT-FLDATE.
SELECTION-SCREEN: END OF BLOCK B1.

TYPES: BEGIN OF TY_STR,
        CARRID TYPE S_CARR_ID,
        FLDATE TYPE S_DATE,
        PRICE TYPE S_PRICE,
        PAYMENTSUM TYPE S_SUM,
        CURRENCY   TYPE S_CURRCODE,
        STATUS TYPE CHAR10,
      END OF TY_STR.

DATA: IT TYPE TABLE OF TY_STR,
      ITFC TYPE SLIS_T_FIELDCAT_ALV,
      WAFC TYPE SLIS_FIELDCAT_ALV,
      ITE TYPE SLIS_T_EVENT,
      WAE TYPE SLIS_ALV_EVENT.
DATA: it_sort TYPE slis_t_sortinfo_alv,
      wa_sort TYPE slis_sortinfo_alv.

SELECT * FROM SFLIGHT INTO CORRESPONDING FIELDS OF TABLE IT UP TO 50 ROWS
 WHERE FLDATE IN A_DATE.

FIELD-SYMBOLS: <FS_DATA> TYPE TY_STR.

LOOP AT IT ASSIGNING <FS_DATA>.
  IF <FS_DATA>-PRICE > 500.
    <FS_DATA>-STATUS = 'PREMIUM'.
  ELSE.
    <FS_DATA>-STATUS = 'STANDARD'.
  ENDIF.
ENDLOOP.

CLEAR WAFC.
  WAFC-COL_POS = 1.
  WAFC-FIELDNAME = 'CARRID'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'CARRID'.
  WAFC-OUTPUTLEN = 15.
  APPEND WAFC TO ITFC.

CLEAR WAFC.
  WAFC-COL_POS = 2.
  WAFC-FIELDNAME = 'FLDATE'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'FLDATE'.
  WAFC-OUTPUTLEN = 15.
  APPEND WAFC TO ITFC.

CLEAR WAFC.
  WAFC-COL_POS = 3.
  WAFC-FIELDNAME = 'PRICE'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'PRICE'.
  WAFC-OUTPUTLEN = 15.
  WAFC-DO_SUM = 'X'.
  APPEND WAFC TO ITFC.

CLEAR WAFC.
  WAFC-COL_POS = 4.
  WAFC-FIELDNAME = 'PAYMENTSUM'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'PAYMENTSUM'.
  WAFC-OUTPUTLEN = 15.
  WAFC-DO_SUM = 'X'.
  APPEND WAFC TO ITFC.

CLEAR WAFC.
  WAFC-COL_POS = 5.
  WAFC-FIELDNAME = 'CURRENCY'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'CURRENCY'.
  WAFC-OUTPUTLEN = 15.
  APPEND WAFC TO ITFC.

CLEAR WAFC.
  WAFC-COL_POS = 6.
  WAFC-FIELDNAME = 'STATUS'.
  WAFC-TABNAME = 'IT'.
  WAFC-SELTEXT_M = 'STATUS'.
  WAFC-OUTPUTLEN = 15.
  APPEND WAFC TO ITFC.

CLEAR wa_sort.
wa_sort-fieldname = 'PRICE'.
wa_sort-subtot    = 'X'. " Activates the total calculation
APPEND wa_sort TO it_sort.

CLEAR wa_sort.
wa_sort-fieldname = 'PAYMENTSUM'.
wa_sort-subtot    = 'X'. " Activates the total calculation
APPEND wa_sort TO it_sort.


CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
 EXPORTING
   I_CALLBACK_PROGRAM                = SY-CPROG
   IT_FIELDCAT                       = ITFC
    it_sort            = it_sort
  TABLES
    T_OUTTAB                          = IT.
