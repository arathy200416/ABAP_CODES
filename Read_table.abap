REPORT ZREADTABLE.

TYPES: BEGIN OF TY_STR,
        ID TYPE I,
        NAME TYPE STRING,
        CITY TYPE STRING,
      END OF TY_STR.

DATA : IT TYPE TABLE OF TY_STR,
      WA TYPE TY_STR.

IT = VALUE #(
  ( ID = 101 NAME = 'ALPHA INC' CITY = 'NEW YORK' )
  ( ID = 102 NAME = 'BETA CORP' CITY = 'LONDON' )
  ( ID = 103 NAME = 'GAMMA LTD' CITY = 'TOKYO' )
).


READ TABLE IT INTO WA INDEX 1.

IF SY-SUBRC = 0.
  WRITE: / 'INDEX READ SUCCESS! NAME: ', WA-NAME.
ENDIF.
CLEAR WA.

READ TABLE IT INTO WA WITH KEY ID = 103 BINARY SEARCH.
WRITE: / WA-ID, 20 WA-NAME, 40 WA-CITY.
